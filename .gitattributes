# OwnTransit release inputs are byte-sensitive. Keep source and metadata on a
# single LF representation across supported development hosts.
* text=auto eol=lf

*.go text eol=lf
*.md text eol=lf
*.json text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.rb text eol=lf
*.in text eol=lf
*.txt text eol=lf
