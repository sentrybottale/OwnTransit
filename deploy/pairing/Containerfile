# Self-test image built from the same checked source as the native CLI artifacts.
# Managed setup runs the relay as a non-root container user.
FROM scratch
COPY --chmod=0755 owntransit-relay-container /owntransit-relay
COPY LICENSE /licenses/Apache-2.0.txt
COPY THIRD_PARTY_NOTICES.md /licenses/THIRD_PARTY_NOTICES.md
USER 65532:65532
ENTRYPOINT ["/owntransit-relay"]
CMD ["pair", "serve", "--state", "/state/relay"]
